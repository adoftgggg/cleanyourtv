<?xml version="1.0" encoding="utf-8"?>
<!-- Fades the full-screen backdrop banner (heroBackdrop) into the dark: towards the left, where the clock and
     the app's name are, and along the bottom, under the tiles. No hard edge anywhere. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#F2000000"
                android:centerColor="#8C000000"
                android:centerX="0.4"
                android:endColor="#14000000"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#F2000000"
                android:centerColor="#59000000"
                android:centerY="0.5"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
